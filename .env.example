# Copy this file to .env and fill in your own values.
# Never commit .env or real credentials.

# Browser-side Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only key for admin operations. Keep private. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Passkey for the /admin portal. Use a long, unique value.
ADMIN_SECRET=

# Google Drive submissions (server only — never prefix with VITE_).
# Service account email from Google Cloud.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Service account private key. Paste with literal \n newlines; the app converts them.
GOOGLE_PRIVATE_KEY=
# Destination folder id from the shared Drive folder URL:
# https://drive.google.com/drive/folders/<THIS_PART>
GOOGLE_DRIVE_FOLDER_ID=

# Optional: signing secret for upload intents. Defaults to ADMIN_SECRET when empty.
UPLOAD_SIGNING_SECRET=

# Optional upload limits (defaults shown).
UPLOAD_MAX_FILE_MB=25
UPLOAD_MAX_FILES=5
UPLOAD_RATE_LIMIT_PER_HOUR=10
